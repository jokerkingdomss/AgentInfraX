// AgentInfra control-plane schema
// Keep in sync with packages/shared-types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions AgentVersion[]
  runs     Run[]

  @@map("agents")
}

model AgentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @db.Uuid
  version    String
  image      String
  entrypoint Json     @default("[]")
  env        Json     @default("{}")
  resources  Json     @default("{\"cpu\":\"500m\",\"memory\":\"512Mi\"}")
  createdAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  Run[]

  @@unique([agentId, version])
  @@map("agent_versions")
}

enum RunStatus {
  pending
  starting
  running
  succeeded
  failed
  stopped
}

model Run {
  id             String     @id @default(uuid()) @db.Uuid
  agentId        String     @db.Uuid
  agentVersionId String     @db.Uuid
  status         RunStatus  @default(pending)
  containerId    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  exitCode       Int?
  errorMessage   String?
  createdAt      DateTime   @default(now())

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("runs")
}
